APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false
APP_URL=http://spacetraders.test

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2524
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Starts remain disabled until migration, backup and credential checks finish.
SPACETRADERS_AUTOMATION_ENABLED=false

# New local manager remains opt-in after owned-fixture verification and a backed-up cutover.
SPACETRADERS_LOCAL_ENGINE_ENABLED=false
SPACETRADERS_OPERATOR_ID=
SPACETRADERS_LOCAL_HOST=spacetraders.test
# Set the verified absolute Herd PHP 8.4 executable when installing the service.
SPACETRADERS_PHP_BINARY=
SPACETRADERS_ROUTE_EVIDENCE=conservative

# Optional absolute override. All checkouts and engine processes must share the same host budget.
# Default: ~/Library/Application Support/SpaceTraders/request-budget
# SPACETRADERS_REQUEST_BUDGET_PATH=/absolute/shared/private/directory
